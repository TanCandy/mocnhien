NODE_ENV=development
PORT=4000

# MongoDB
MONGODB_URI="mongodb://localhost:27017/moc-nhien-authentic"

# JWT
JWT_SECRET="change_me_to_a_long_random_secret"
JWT_EXPIRES_IN="7d"
JWT_ISSUER="moc-nhien-authentic"

# Password hashing
BCRYPT_SALT_ROUNDS=12

# Pricing
QUOTE_EXCHANGE_RATE_VND_PER_USD=23000

# Resend (transactional email)
# Get an API key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM="Moc Nhien Authentic <onboarding@resend.dev>"

# Frontend base URL — used to build password-reset links
CLIENT_URL=http://localhost:3000
FRONTEND_BASE_URL=http://localhost:3000
