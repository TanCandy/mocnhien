NODE_ENV=development
PORT=4000

# Comma-separated list of origins allowed to call this API with credentials.
# No wildcard fallback — requests from any other origin are rejected.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# MongoDB
MONGODB_URI="mongodb://localhost:27017/moc-nhien-authentic"

# JWT
JWT_SECRET="change_me_to_a_long_random_secret"
JWT_EXPIRES_IN="7d"
JWT_ISSUER="moc-nhien-authentic"

# Password hashing
BCRYPT_SALT_ROUNDS=12

# Pricing
QUOTE_EXCHANGE_RATE_VND_PER_USD=23000

# Resend (transactional email)
# Get an API key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM="Moc Nhien Authentic <onboarding@resend.dev>"

# Frontend base URL — used to build password-reset links
CLIENT_URL=http://localhost:3000
FRONTEND_BASE_URL=http://localhost:3000

# Google Apps Script web-app URL for syncing orders to Google Sheets
# (source: integrations/google-sheets/Code.gs). Leave empty to skip the sync.
WEBHOOK_URL=
# Shared secret — must equal the WEBHOOK_SECRET script property in Apps Script.
WEBHOOK_SECRET=

# Behind a reverse proxy (Caddy/Nginx) set the number of proxy hops, e.g. 1,
# so rate limiting sees real client IPs. Leave empty when not proxied.
TRUST_PROXY=

# Bank account shown on payment QR codes (PAYMENT_BANK_BIN = NAPAS bank code)
PAYMENT_BANK_BIN=970426
PAYMENT_BANK_NAME=MSB
PAYMENT_ACCOUNT_NUMBER=80002725995
PAYMENT_ACCOUNT_NAME="LE THI DIEU"

# SePay webhook API key (automatic payment confirmation). Empty = disabled.
# Webhook URL: https://<your-domain>/api/payments/webhook/sepay
SEPAY_WEBHOOK_API_KEY=

# Sentry (error tracking). Leave empty to disable — the app runs with no
# error reporting if unset.
SENTRY_DSN=
