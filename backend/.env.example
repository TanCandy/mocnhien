NODE_ENV=development
PORT=4000

# MongoDB
MONGODB_URI="mongodb://localhost:27017/moc-nhien-authentic"

# JWT
JWT_SECRET="change_me_to_a_long_random_secret"
JWT_EXPIRES_IN="7d"
JWT_ISSUER="moc-nhien-authentic"

# Password hashing
BCRYPT_SALT_ROUNDS=12

# Pricing
QUOTE_EXCHANGE_RATE_VND_PER_USD=23000

# Email (Gmail SMTP via App Password)
# Generate an App Password at https://myaccount.google.com/apppasswords
# Do NOT use your normal Gmail password.
EMAIL_USER=your.email@gmail.com
EMAIL_PASS=your_16_char_app_password
EMAIL_FROM_NAME=Moc Nhien Authentic

# Frontend base URL — used to build password-reset links
FRONTEND_BASE_URL=http://localhost:3000

