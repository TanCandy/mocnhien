# ─────────────────────────────────────────────────────────────────────────────
# Production settings for docker-compose.yml. On the server:
#
#   cp .env.production.example .env
#   chmod 600 .env
#
# Never commit the real .env. Generate secrets with:  openssl rand -hex 32
# ─────────────────────────────────────────────────────────────────────────────

# ── Domain / URLs ────────────────────────────────────────────────────────────
# DNS A record must point at this server before the first `docker compose up`.
DOMAIN=shop.example.com
# Public URL of the site (password-reset links, CORS). Same domain, with https://
CLIENT_URL=https://shop.example.com
FRONTEND_BASE_URL=https://shop.example.com
# Comma-separated origins allowed to call the API (add www. if you serve it)
ALLOWED_ORIGINS=https://shop.example.com

# ── MongoDB (bundled container) ──────────────────────────────────────────────
# Used only when the database volume is first created. Use hex/alphanumeric
# characters only (the password is embedded in a connection URL).
MONGO_ROOT_USER=mocnhien
MONGO_ROOT_PASSWORD=CHANGE_ME_openssl_rand_hex_24
MONGO_DB=moc-nhien

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
JWT_EXPIRES_IN=7d
JWT_ISSUER=moc-nhien-authentic
BCRYPT_SALT_ROUNDS=12

# ── Pricing ──────────────────────────────────────────────────────────────────
QUOTE_EXCHANGE_RATE_VND_PER_USD=23000

# ── Bank account shown on payment QR codes ──────────────────────────────────
# PAYMENT_BANK_BIN is the NAPAS bank code (MSB = 970426, Vietcombank = 970436,
# Techcombank = 970407, MB = 970422, ACB = 970416, VPBank = 970432, BIDV = 970418).
PAYMENT_BANK_BIN=970426
PAYMENT_BANK_NAME=MSB
PAYMENT_ACCOUNT_NUMBER=80002725995
PAYMENT_ACCOUNT_NAME=LE THI DIEU

# ── Automatic payment confirmation (SePay webhook) ──────────────────────────
# Webhook URL to enter in SePay:  https://<DOMAIN>/api/payments/webhook/sepay
# Authentication: "API Key" — paste the same value here. Leave empty to turn
# automatic confirmation off (admins then record payments by editing orders).
SEPAY_WEBHOOK_API_KEY=

# ── Google Sheet sync (optional) ─────────────────────────────────────────────
# Web-app URL of integrations/google-sheets/Code.gs, and the shared secret you
# set as the script property WEBHOOK_SECRET. Both empty = sync off.
WEBHOOK_URL=
WEBHOOK_SECRET=

# ── Email (password reset) ───────────────────────────────────────────────────
# https://resend.com/api-keys — the "from" domain must be verified in Resend.
RESEND_API_KEY=
RESEND_FROM=Moc Nhien Authentic <no-reply@shop.example.com>

# ── Error tracking (optional) ────────────────────────────────────────────────
SENTRY_DSN=
